# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=dpuser
POSTGRES_PASSWORD=dppassword
POSTGRES_DB=demandplatform

# ─── ClickHouse ────────────────────────────────────────────────
CLICKHOUSE_USER=dpuser
CLICKHOUSE_PASSWORD=dppassword
CLICKHOUSE_DB=demand

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=dpredis

# ─── MinIO (S3-compatible object store) ────────────────────────
MINIO_ROOT_USER=dpminiouser
MINIO_ROOT_PASSWORD=dpminiopassword

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-256-bit-random

# ─── AI / LLM (for AI dashboard builder) ──────────────────────
OPENAI_API_KEY=sk-...

# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8002
